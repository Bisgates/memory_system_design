  rule:r001g_same_round_as_symmetric
      when : [['?a', 'same_round_as', '?b']]
      then : [['?b', 'same_round_as', '?a']]
      status: active
  rule:r002_derived_from_reverse
      when : [['?a', 'derived_from', '?b']]
      then : [['?b', 'derives_to', '?a']]
      status: active
  rule:r003_competes_with_symmetry
      when : [['?a', 'competes_with', '?b']]
      then : [['?b', 'competes_with', '?a']]
      status: active
  rule:r004_falsifies_cluster
      when : [['?a', 'falsifies', '?b'], ['?b', 'falsifies', '?c']]
      then : [['?a', 'inherits_falsification', '?c']]
      status: active
  rule:r005_anti_pattern_inheritance
      when : [['?ap', 'references_in_case_examples', '?exp']]
      then : [['?exp', 'is_instance_of_anti_pattern', '?ap']]
